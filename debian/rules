#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@

# The upstream Makefile is used by dh_auto_* (build, test, install, clean).
# Documentation, examples and the manual page are installed by debhelper.
override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr INSTALL_FLAGS=--no-docs
