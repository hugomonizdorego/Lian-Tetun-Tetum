#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# Remove the locale generated by postinst, but only if this package created it.
remove_locale() {
	target=/usr/lib/locale/tet_TL.utf8
	marker="$target/.eduka-tet-owner"
	if [ -d "$target" ] && [ ! -L "$target" ] && [ -f "$marker" ] && [ ! -L "$marker" ] &&
	   [ "$(cat "$marker")" = eduka-language-pack-tet ]; then
		rm -rf -- "$target"
	fi
}

case "$1" in
	remove|purge)
		remove_locale
	;;
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;
	*)
		echo "postrm called with unknown argument \`$1'" >&2
		exit 1
	;;
esac

#DEBHELPER#

exit 0
