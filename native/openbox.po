msgstr "  --config-file FILE  Indika dalan arkivu konfigurasaun atu uza\n"

#: openbox/openbox.c:541
#. OB-0069; needs-INL-review
msgid "  --sm-disable        Disable connection to the session manager\n"
msgstr "  --sm-disable        Dezativa ligasaun ba jestór sesaun\n"

