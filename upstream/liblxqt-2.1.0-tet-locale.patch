@@ -40,6 +40,20 @@
 
 using namespace LXQt;
 
+// Tetun is not represented in the Qt 6.8 QLocale tables. Preserve its raw
+// POSIX identifier for explicit catalog lookup instead of silently using C.
+static QString translationLocale()
+{
+    QByteArray raw = qgetenv("LC_ALL");
+    if (raw.isEmpty()) raw = qgetenv("LC_MESSAGES");
+    if (raw.isEmpty()) raw = qgetenv("LANG");
+    if (raw == "tet" || raw.startsWith("tet_") ||
+        raw.startsWith("tet-") || raw.startsWith("tet.") ||
+        raw.startsWith("tet@"))
+        return QStringLiteral("tet_TL");
+    return QLocale::system().name();
+}
+
 bool translate(const QString &name, const QString &owner = QString());
